[sub_resource type="GDScript" id="GDScript_ffog2"]
script/source = "extends Node

@onready var slide_temp_3: Slide = $\"..\"

@onready var slide_changer: SlideChanger = $\"../..\"
@onready var button_red: RedButton = $\"../../../Button_red\"
@onready var scale_button_green: Area2D = $\"../../../Scale_button_green\"


func _on_button_red_pressed(state: Variant, body: Variant) -> void:
	if slide_changer.lock_input == true:
		slide_changer.lock_input = false
		slide_changer.drop_current_slide()
		scale_button_green.monitoring = true


func _on_slide_temp_3_visibility_changed() -> void:
	if slide_temp_3.visible == true:
		button_red.monitoring = true
		slide_changer.lock_input = true
"

[sub_resource type="GDScript" id="GDScript_qvjxb"]
script/source = "extends Node


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	pass


func _on_scale_button_green_pressed(state: Variant, body: Variant) -> void:
	if state == true:
		print(\"Good\")
"

