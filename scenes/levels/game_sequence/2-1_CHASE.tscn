[sub_resource type="GDScript" id="GDScript_01tns"]
script/source = "extends Path2D

@onready var path_follow_2d = $PathFollow2D


@export var runtoggle : bool


func _process(delta):
	match  runtoggle:
		false:
			pass
		true:
			run()

func run():
	if path_follow_2d.progress_ratio < 0.99:
		path_follow_2d.progress_ratio += 0.01
		print(path_follow_2d.progress_ratio)
	else:
		self.queue_free()


func _on_area_2d_body_entered(body):
	if body is SlimePlayer:
		runtoggle = true
"

