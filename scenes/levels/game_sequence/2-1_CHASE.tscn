[sub_resource type="GDScript" id="GDScript_dhrqb"]
script/source = "extends Area2D
@onready var zoom : bool = false
@onready var camera : Camera2D
@export var dialogbox : DialogComponent
@onready var transition = $\"../CharacterBody2D2/Transition\"

func _physics_process(delta):
	if zoom == true:
		if camera.zoom > Vector2(1, 1):
			print(\"Zooming\")
			camera.zoom -= Vector2(0.01, 0.01)
		else:
			self.queue_free()

func _on_body_entered(body:Node2D):
	if body.is_in_group(\"Player\"):
		transition.visible = false
		zoom = true
		camera = body.find_child(\"Camera2D\")
		
"

