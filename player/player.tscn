color = Color(0.333333, 1, 0, 1)
energy = 0.5
texture = ExtResource("36_xf517")
texture_scale = 0.5

[node name="SFXHandler" type="AudioStreamPlayer2D" parent="."]
max_polyphony = 4
bus = &"SFX"
script = ExtResource("36_ge24q")

[node name="CoyoteTimer" type="Timer" parent="."]
one_shot = true

[connection signal="Grab" from="." to="SFXHandler" method="_on_character_body_2d_grab"]
[connection signal="Jump" from="." to="SFXHandler" method="_on_character_body_2d_jump"]
[connection signal="Movement" from="." to="SFXHandler" method="_on_character_body_2d_movement"]
[connection signal="Throw" from="." to="SFXHandler" method="_on_character_body_2d_throw"]
[connection signal="scare" from="." to="." method="_on_scare"]
[connection signal="body_entered" from="Selector/Crosshair/ObjectDetect" to="." method="_on_object_detect_body_entered"]
[connection signal="Unpressed" from="SFXHandler" to="SFXHandler" method="_on_unpressed"]
[connection signal="timeout" from="CoyoteTimer" to="." method="_on_coyote_timer_timeout"]
